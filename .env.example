# =============================================================================
# Vows n Knots - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the key for the provider you select,
# plus the Tavily key used by web search.
# Never commit .env to version control (it is already in .gitignore).

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Chat provider used by the main wedding-planner agent and both sub-agents.
# Options: google_genai, groq, openai, nvidia
# Default when unset: nvidia
LLM_PROVIDER=nvidia

# Model name for each provider (optional; the default is used when unset or blank)
# google_genai default: gemini-3.1-flash-lite
GOOGLE_MODEL=gemini-3.1-flash-lite
# groq default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
# openai default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# nvidia default: nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA is created with LangChain's NVIDIA integration (model_provider="nvidia").
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# Set the key that matches LLM_PROVIDER. The others can stay empty.
# Google Gemini API key. Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq API key. Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key. Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# NVIDIA API key. Get yours at: https://build.nvidia.com
NVIDIA_API_KEY=

# -----------------------------------------------------------------------------
# Web Search
# -----------------------------------------------------------------------------
# Tavily API key used by the search_web tool. Get yours at: https://app.tavily.com
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Level for stdout and logs/vows_n_knots.log.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO
